# Backend - MT5
CUSTOM_USER=admin
PASSWORD=1234
VNC_DOMAIN=vnc.example.com
API_DOMAIN=api.example.com

# MT5 API Configuration
# MT5_API_PORT is the port the Flask app listens on inside the container.
MT5_API_PORT=5001

# Host port mappings (compose)
MT5_GATEWAY_API_PORT=10003
MT5_GATEWAY_VNC_PORT=10004

# Swagger UI scheme configuration (default: http)
# Set to "https" for production deployments behind reverse proxy
SWAGGER_SCHEME=http

# Broker server timezone (IANA name). Authoritative when set — the gateway
# uses it to translate MT5's broker-wallclock-as-UTC timestamps to real UTC
# immediately at startup, with no race window for early-arriving requests.
# When unset, a background probe will infer the timezone from a tick after
# the first ~5–15s of uptime; until then, timestamps will be emitted unchanged.
# Examples: Europe/Athens (the5ers, IC Markets EET/EEST), UTC (Exness, IC UTC).
BROKER_TIMEZONE=

# MT5 Connection Settings
# Maximum attempts to reconnect to MT5 when connection is lost (default: 3)
MT5_RECONNECT_ATTEMPTS=3

# Base delay in seconds between reconnection attempts (uses exponential backoff, default: 1.0)
MT5_RECONNECT_BASE_DELAY=1.0

# Logging Configuration
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO

# Traefik
TRAEFIK_DOMAIN=traefik.example.com
TRAEFIK_USERNAME=admin
ACME_EMAIL=admin@example.com